 <office:body>
  <office:drawing>
   <draw:page draw:name="page1" draw:style-name="dp2" draw:master-page-name="Default">
    <draw:g draw:name="calc a1" draw:style-name="gr1">
     <draw:frame draw:name="calc a1 heading" draw:style-name="gr2" draw:text-style-name="P2" draw:layer="layout" svg:width="4cm" svg:height="0.37cm" svg:x="0.4cm" svg:y="0.4cm">
