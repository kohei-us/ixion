<draw:custom-shape draw:name="tracker" draw:style-name="Code_20_Box" draw:text-style-name="P_center" draw:layer="layout" xml:id="id4" draw:id="id4" svg:width="3.440cm" svg:height="0.953cm" svg:x="10.583cm" svg:y="2.646cm"><text:p text:style-name="P_center">dirty_cell_tracker</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
<draw:line draw:name="tracker into query" draw:style-name="Flow_20_Arrow" draw:layer="layout" svg:x1="10.583cm" svg:y1="3.122cm" svg:x2="8.731cm" svg:y2="3.122cm"><text:p/></draw:line>
<draw:line draw:name="query to sorted" draw:style-name="Flow_20_Arrow" draw:layer="layout" svg:x1="6.085cm" svg:y1="3.598cm" svg:x2="6.085cm" svg:y2="4.498cm"><text:p/></draw:line>
</draw:g>
<draw:g draw:name="sorted">
<draw:custom-shape draw:name="sorted frame" draw:style-name="Code_20_Box" draw:text-style-name="P_center" draw:layer="layout" xml:id="id5" draw:id="id5" svg:width="5.292cm" svg:height="1.640cm" svg:x="3.440cm" svg:y="4.498cm"><text:p/><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
<draw:frame draw:name="sorted heading" draw:style-name="Annotation" draw:text-style-name="P_label" draw:layer="layout" svg:width="5.027cm" svg:height="0.370cm" svg:x="3.651cm" svg:y="4.604cm"><draw:text-box><text:p text:style-name="P_label">Dirty formula cells, sorted</text:p></draw:text-box></draw:frame>
<draw:custom-shape draw:name="sorted A11" draw:style-name="Token" draw:text-style-name="P_small" draw:layer="layout" xml:id="id6" draw:id="id6" svg:width="1.164cm" svg:height="0.582cm" svg:x="4.498cm" svg:y="5.292cm"><text:p text:style-name="P_small">A11</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
<draw:line draw:name="order arrow" draw:style-name="Flow_20_Arrow" draw:layer="layout" svg:x1="5.768cm" svg:y1="5.583cm" svg:x2="6.403cm" svg:y2="5.583cm"><text:p/></draw:line>
<draw:custom-shape draw:name="sorted B1" draw:style-name="Token" draw:text-style-name="P_small" draw:layer="layout" xml:id="id7" draw:id="id7" svg:width="1.164cm" svg:height="0.582cm" svg:x="6.509cm" svg:y="5.292cm"><text:p text:style-name="P_small">B1</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
<draw:line draw:name="sorted to calculate" draw:style-name="Flow_20_Arrow" draw:layer="layout" svg:x1="6.085cm" svg:y1="6.138cm" svg:x2="6.085cm" svg:y2="7.038cm"><text:p/></draw:line>
</draw:g>
<draw:g draw:name="calculate">
<draw:custom-shape draw:name="calculate step" draw:style-name="Step" draw:text-style-name="P_center" draw:layer="layout" xml:id="id8" draw:id="id8" svg:width="5.292cm" svg:height="0.953cm" svg:x="3.440cm" svg:y="7.038cm"><text:p text:style-name="P_center">calculate_sorted_cells()</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
<draw:line draw:name="calculate to results" draw:style-name="Flow_20_Arrow" draw:layer="layout" svg:x1="6.085cm" svg:y1="7.990cm" svg:x2="6.085cm" svg:y2="8.890cm"><text:p/></draw:line>
</draw:g>
<draw:g draw:name="results">
<draw:custom-shape draw:name="results frame" draw:style-name="Code_20_Box" draw:text-style-name="P_center" draw:layer="layout" xml:id="id9" draw:id="id9" svg:width="5.292cm" svg:height="1.323cm" svg:x="3.440cm" svg:y="8.890cm"><text:p/><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
<draw:frame draw:name="results heading" draw:style-name="Annotation" draw:text-style-name="P_label" draw:layer="layout" svg:width="5.027cm" svg:height="0.370cm" svg:x="3.651cm" svg:y="8.996cm"><draw:text-box><text:p text:style-name="P_label">Results cached in the cells</text:p></draw:text-box></draw:frame>
<draw:custom-shape draw:name="result A11" draw:style-name="Token" draw:text-style-name="P_small" draw:layer="layout" xml:id="id10" draw:id="id10" svg:width="1.905cm" svg:height="0.582cm" svg:x="4.022cm" svg:y="9.472cm"><text:p text:style-name="P_small">A11 = 100</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
<draw:custom-shape draw:name="result B1" draw:style-name="Token" draw:text-style-name="P_small" draw:layer="layout" xml:id="id11" draw:id="id11" svg:width="1.905cm" svg:height="0.582cm" svg:x="6.244cm" svg:y="9.472cm"><text:p text:style-name="P_small">B1 = 200</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
</draw:g>
   </draw:page>
